UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Choose otistx or viotp. Keep provider credentials server-side.
SIM_PROVIDER=otistx
OTISTX_API_KEY=
SIM_SERVICE=otissim_v3
SIM_CARRIER=viettel

# Fallback retail price when there is no saved admin price or service override.
SIM_PRICE_VND=5000
SIM_PRICE_OTISSIM_V1=6000
SIM_PRICE_OTISSIM_V2=7000
SIM_PRICE_OTISSIM_V3=8000
SIM_PRICE_OTISSIM_V4=9000
SIM_PRICE_OTISSIM_V5=10000
SIM_PRICE_OTISSIM_V6=11000
SIM_PRICE_OTISSIM_V7=8000
SIM_PRICE_OTISSIM_V8=8000

# Optional ViOTP provider configuration.
VIOTP_TOKEN=
# Configure one ViOTP service ID per OtisSim service to enable it in the UI.
VIOTP_SERVICE_ID_OTISSIM_V1=
VIOTP_SERVICE_ID_OTISSIM_V2=
VIOTP_SERVICE_ID_OTISSIM_V3=
VIOTP_SERVICE_ID_OTISSIM_V4=
VIOTP_SERVICE_ID_OTISSIM_V5=
VIOTP_SERVICE_ID_OTISSIM_V6=
VIOTP_SERVICE_ID_OTISSIM_V7=4
# Backward-compatible service ID for SIM_SERVICE (defaults to otissim_v7 / Shopee).
VIOTP_SHOPEE_SERVICE_ID=4

# Optional OtpHub VIP (SIM OTP V8 VIP) configuration.
OTPHUB_BASE_URL=https://otphubtl.vercel.app
OTPHUB_TOKEN=
OTPHUB_SHOPEE_SERVICE_ID=shopee


# Required to access admin price settings and wallet credits.
ADMIN_API_TOKEN=

# SePay bank-transfer auto top-up.
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_MIN_DEPOSIT_VND=10000
